import sys
import os
import json
import time

CONFIG_PATH = os.path.expanduser('~/.config/time_announcer.json')

DEFAULT_CONFIG = {
    "enabled": True,
    "interval_minutes": 15,
    "type": "clock", # "clock" or "relative"
    "mode": "only",  # "only" or "avoid"
    "start_time": "18:00",
    "end_time": "10:30",
    "last_run": 0,
    "debug": False
}

def load_or_create_config():
    if not os.path.exists(os.path.dirname(CONFIG_PATH)):
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    if not os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, 'w') as f:
            json.dump(DEFAULT_CONFIG, f, indent=4)
        return DEFAULT_CONFIG
    with open(CONFIG_PATH, 'r') as f:
        return json.load(f)

def save_and_reload(config):
    with open(CONFIG_PATH, 'w') as f:
        json.dump(config, f, indent=4)
    print("Configuration updated successfully.")
    os.system("launchctl unload ~/Library/LaunchAgents/com.user.timeannouncer.plist 2>/dev/null")
    if config["enabled"]:
        os.system("launchctl load ~/Library/LaunchAgents/com.user.timeannouncer.plist")
        print("Announcer Daemon: ACTIVE")
    else:
        print("Announcer Daemon: STOPPED/DISABLED")

def print_help():
    print("""
Mac Time Announcer Utility Control
Usage:
  saytime start                    - Start/Enable announcements
  saytime stop                     - Stop/Disable announcements
  saytime interval [minutes] [--use_last_run] - Change interval (e.g., 15, 30, 60)
  saytime type [clock|relative] [--use_last_run] - clock (e.g., 15th min) vs relative (from now)
  saytime range [only|avoid] [HH:MM] [HH:MM] - Set conditional rule constraints
  saytime debug [on|off]           - Enable/disable debug logging
  saytime status                   - View current profile parameters
  saytime help                     - Show this help menu

In relative mode, 'type relative' and 'interval' restart the countdown from now.
Add --use_last_run to keep counting from the last announcement instead.
""")

# Strip the optional flag so positional arguments keep their positions
use_last_run = "--use_last_run" in sys.argv
sys.argv = [a for a in sys.argv if a != "--use_last_run"]

if len(sys.argv) < 2:
    print_help()
    sys.exit(0)

cmd = sys.argv[1].lower()
cfg = load_or_create_config()

if cmd in ["help", "-h", "--help"]:
    print_help()
elif cmd == "start":
    cfg["enabled"] = True
    save_and_reload(cfg)
elif cmd == "stop":
    cfg["enabled"] = False
    save_and_reload(cfg)
elif cmd == "interval":
    cfg["interval_minutes"] = int(sys.argv[2])
    if cfg.get("type") == "relative" and not use_last_run:
        cfg["last_run"] = time.time()
    save_and_reload(cfg)
elif cmd == "type":
    val = sys.argv[2].lower()
    if val in ["clock", "relative"]:
        cfg["type"] = val
        if val == "relative" and not use_last_run:
            cfg["last_run"] = time.time()
        save_and_reload(cfg)
    else:
        print("Invalid type. Choose 'clock' or 'relative'")
elif cmd == "range":
    if len(sys.argv) < 5:
        print("Error: Provide parameters like: saytime range only 18:00 10:30 (or 'avoid')")
        sys.exit(1)
    mode_val = sys.argv[2].lower()
    if mode_val not in ["only", "avoid"]:
        print("Error: Mode must be either 'only' or 'avoid'")
        sys.exit(1)
    cfg["mode"] = mode_val
    cfg["start_time"] = sys.argv[3]      # "18:00"
    cfg["end_time"] = sys.argv[4]        # "10:30"
    save_and_reload(cfg)
elif cmd == "debug":
    if len(sys.argv) > 2:
        sub = sys.argv[2].lower()
        if sub in ["on", "true", "1", "enable"]:
            cfg["debug"] = True
            save_and_reload(cfg)
            print("Debug mode: ENABLED (logs written to ~/.config/time_announcer_logs/)")
        elif sub in ["off", "false", "0", "disable"]:
            cfg["debug"] = False
            save_and_reload(cfg)
            print("Debug mode: DISABLED")
        else:
            print("Invalid option. Use 'saytime debug on' or 'saytime debug off'")
    else:
        status = "ENABLED" if cfg.get("debug", False) else "DISABLED"
        print(f"Debug mode is currently: {status}")
elif cmd == "status":
    print(json.dumps(cfg, indent=4))
else:
    print_help()
